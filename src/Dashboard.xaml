    </StackPanel></ScrollViewer>
    <Grid x:Name="EditorPanel" Visibility="Collapsed" Margin="18,6,18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button x:Name="BackButton" Content="‹  Back" HorizontalAlignment="Left" Background="Transparent" Padding="0,5,15,12"/><ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="EditorContent"/></ScrollViewer></Grid>
