       <Border Width="9" Height="9" Background="{Binding Color}" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#AAAAAA" Margin="0,3,0,0"/></StackPanel>
