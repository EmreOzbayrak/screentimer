     <Grid Margin="0,5,0,12" Height="185"><Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="180" Height="180" HorizontalAlignment="Left"><Canvas x:Name="Donut" Width="180" Height="180"/>
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="130"><TextBlock x:Name="TotalTime" Text="0m" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="ChartCaption" Text="active time" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="125" Margin="0,3,0,0"/></StackPanel>
      </Grid><StackPanel x:Name="CategoryLegend" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
     </Grid>
     <Grid Background="#202020" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="CategoriesButton" Content="Categories" Background="Transparent" FontSize="12"/><Button x:Name="AppsButton" Grid.Column="1" Content="Apps" FontSize="12"/><Button x:Name="PagesButton" Grid.Column="2" Content="Pages" Background="Transparent" FontSize="12"/></Grid>
